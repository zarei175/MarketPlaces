# نمونه متغیرهای محیطی — این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید
# (.env به گیت پوش نمی‌شود؛ این فایل فقط الگوست)
# ⚠️ هرگز مقدار واقعی هیچ کلید/توکنی را در این فایل یا هر فایل commit‌شده نگذارید.

# ── Supabase (بک‌اند فاز ۱) ──
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_ACCESS_TOKEN

# Prisma روی Supabase — از Settings > Database پنل پروژه
# (رمز دیتابیس را از خودتان دارید؛ در صورت فراموشی از Management API ریست کنید)
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ── وضعیت فعلی: دیتابیس توسعه محلی (SQLite) تا مهاجرت فاز ۱ ──
DATABASE_URL="file:./dev.db"

# ── کاوه‌نگار — پیامک/OTP ──
KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY
