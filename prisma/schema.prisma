generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int      // price in Tomans
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

